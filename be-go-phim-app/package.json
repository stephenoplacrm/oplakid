{
  "name": "be-go-phim",
  "version": "1.0.0",
  "private": true,
  "description": "Bé Gõ Phím: web app luyện gõ phím cho trẻ, có tài khoản phụ huynh, hồ sơ bé và đua trực tuyến.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:env": "node --env-file=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "express": "4.22.3",
    "nodemailer": "10.1.7",
    "three": "0.128.0",
    "ws": "8.22.0"
  }
}